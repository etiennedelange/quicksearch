{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickSearch",
  "version": "0.1.0",
  "identifier": "io.github.etiennedelange.quicksearch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QuickSearch",
        "width": 900,
        "height": 560,
        "minWidth": 480,
        "minHeight": 300,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "backgroundColor": "#EDE7DA"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Whole-drive file and content search on a global hotkey.",
    "copyright": "Copyright (c) 2026 Etienne de Lange",
    "license": "MIT"
  },
  "mainBinaryName": "quicksearch"
}
